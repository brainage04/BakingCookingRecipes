---
import SiteLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import StatCard from '@brainage04/astro-shell/components/StatCard.astro';
import TerminalPanel from '@brainage04/astro-shell/components/TerminalPanel.astro';
import { recipes } from '../data/recipes';
import PriceNote from '../components/PriceNote.astro';

const shoppingRecipes = recipes.map((recipe) => ({
  slug: recipe.slug,
  title: recipe.meta.title,
  navTitle: recipe.navTitle,
  ingredients: recipe.ingredients,
  alternativeControls: recipe.alternativeControls,
}));

const alternativeControls = Array.from(
  new Map(recipes.flatMap((recipe) => recipe.alternativeControls.map((control) => [control.key, control]))).values(),
);
---

<SiteLayout
  title="Combined Shopping List"
  description="Choose cookie and brownie batch counts and generate one combined Woolworths ingredient list."
>
  <div class="site-stack">
    <TerminalPanel class="stack" id="shopping-list">
      <p id="shopping-summary-status" class="sr-only" role="status"></p>
      <div class="shopping-controls">
        <div class="shopping-batches" role="group" aria-label="Recipe batch counts">
          {
            shoppingRecipes.map((recipe) => (
              <div class="control-card">
                <label class="field" for={`batch-${recipe.slug}`}>
                  <span>{recipe.title} batches</span>
                  <input
                    id={`batch-${recipe.slug}`}
                    data-recipe-batches={recipe.slug}
                    type="number"
                    min="0"
                    step="any"
                    inputmode="decimal"
                    value="1"
                  />
                </label>
              </div>
            ))
          }
        </div>

        <div class="control-card toggle-list shopping-toggles" role="group" aria-label="Ingredient alternatives">
          {
            alternativeControls.map((control) => (
              <label>
                <input
                  id={`combined-toggle-${control.key}`}
                  data-alternative-key={control.key}
                  type="checkbox"
                  checked={control.defaultChecked}
                />
                <span>{control.label}</span>
              </label>
            ))
          }
        </div>

        <div class="shopping-summary" role="group" aria-label="Shopping list totals">
          <StatCard
            class="stat-used-cost"
            label="Used ingredient cost"
            valueId="used-cost-output"
            note="Proportional cost across both recipes."
          />
          <StatCard
            class="stat-basket"
            label="Basket estimate"
            valueId="basket-cost-output"
            note="Rounds combined quantities up to whole Woolworths packs."
          />
        </div>
      </div>

      <PriceNote priceDates={recipes.map((recipe) => recipe.meta.priceDate)} />

      <div class="table-wrap table-wrap--stack" role="region" aria-label="Combined shopping list" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>Woolworths item</th>
              <th>Needed for recipes</th>
              <th>Total needed</th>
              <th>Packs to buy</th>
              <th>Basket cost</th>
            </tr>
          </thead>
          <tbody id="shopping-rows"></tbody>
        </table>
      </div>
    </TerminalPanel>
  </div>

  <script
    is:inline
    type="application/json"
    id="shopping-data"
    set:html={JSON.stringify({ recipes: shoppingRecipes, alternativeControls })}
  />

  <script src="../scripts/shoppingList.ts"></script>
</SiteLayout>
