---
import SiteLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { withBase } from '@brainage04/astro-shell/withBase';
import { meals } from '../../data/meals';
---

<SiteLayout
  title="Meals"
  description="Protein ice cream, iced coffee, butter chicken and spaghetti bolognese with calories and macros from Australian nutrition panels."
>
  <div class="recipes-home">
    <h1 class="sr-only">Meals</h1>

    <section class="home-section" aria-labelledby="meals-title">
      <h2 id="meals-title">Meals</h2>
      <div class="recipe-grid">
        {
          meals.map((meal) => (
            <a class="recipe-card" href={withBase(`/meals/${meal.slug}/`)}>
              <h3>{meal.cardTitle}</h3>
              <span>Open nutrition</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</SiteLayout>
