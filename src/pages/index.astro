---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '@brainage04/astro-shell/withBase';
import { recipes } from '../data/recipes';

const shoppingHref = withBase('/shopping-list/');
---

<SiteLayout
  title="Home"
  description="Recipe calculators for cookies and brownies with Woolworths cost estimates and bake notes."
>
  <div class="recipes-home">
    <h1 class="sr-only">BakingCookingRecipes</h1>

    <section class="home-section" aria-labelledby="recipes-title">
      <h2 id="recipes-title">Recipes</h2>
      <div class="recipe-grid">
        {
          recipes.map((recipe) => (
            <a class="recipe-card" href={withBase(`/${recipe.slug}/`)}>
              <h3>{recipe.cardTitle}</h3>
              <span>Open calculator</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="shopping-title">
      <h2 id="shopping-title">Combined shopping list</h2>
      <div class="recipe-grid">
        <a class="recipe-card shopping-card" href={shoppingHref}>
          <h3>Open combined shopping list</h3>
          <span>Combine recipe ingredients</span>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
