---
import type { RecipeOption } from '../data/types';

export interface Props {
  options: readonly RecipeOption[];
  /** Keeps radio group names and ids unique when several recipes share a page. */
  prefix: string;
}

const { options, prefix } = Astro.props;
---

{
  options.map((option) => {
    const id = `${prefix}-${option.key}`;
    return (
      <div class="option-field">
        {option.kind === 'toggle' && (
          <label class="option-check">
            <input
              id={id}
              type="checkbox"
              data-option-key={option.key}
              data-option-kind="toggle"
              checked={option.defaultValue}
            />
            <span>{option.label}</span>
          </label>
        )}
        {option.kind === 'choice' && option.control === 'radio' && (
          <fieldset>
            <legend>{option.label}</legend>
            {option.choices.map((choice) => (
              <label class="option-check">
                <input
                  type="radio"
                  name={id}
                  value={choice.value}
                  data-option-key={option.key}
                  data-option-kind="choice"
                  checked={choice.value === option.defaultValue}
                />
                <span>{choice.label}</span>
              </label>
            ))}
          </fieldset>
        )}
        {option.kind === 'choice' && option.control === 'select' && (
          <label class="field" for={id}>
            <span>{option.label}</span>
            <select id={id} data-option-key={option.key} data-option-kind="choice">
              {option.choices.map((choice) => (
                <option value={choice.value} selected={choice.value === option.defaultValue}>
                  {choice.label}
                </option>
              ))}
            </select>
          </label>
        )}
        {option.kind === 'amount' && (
          <label class="field" for={id}>
            <span>
              {option.label} ({option.unit})
            </span>
            <input
              id={id}
              type="number"
              min={option.min}
              max={option.max}
              step={option.step}
              inputmode="decimal"
              value={option.defaultValue}
              data-option-key={option.key}
              data-option-kind="amount"
            />
          </label>
        )}
        {option.hint && <small class="muted">{option.hint}</small>}
      </div>
    );
  })
}
