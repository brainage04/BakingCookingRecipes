---
import SiteLayout from '../layouts/SiteLayout.astro';
import TerminalPanel from '@brainage04/astro-shell/components/TerminalPanel.astro';
import type { RecipePageData } from '../data/recipes';

export interface Props {
  recipe: RecipePageData;
}

const { recipe } = Astro.props;
const calculatorData = {
  ingredients: recipe.ingredients,
  alternativeControls: recipe.alternativeControls,
  servingsPerBatch: recipe.servingsPerBatch,
  servingSingular: recipe.servingSingular,
  servingPlural: recipe.servingPlural,
};

const servingPluralTitle = `${recipe.servingPlural.charAt(0).toUpperCase()}${recipe.servingPlural.slice(1)}`;

const estimatedMassGrams = recipe.ingredients.reduce((total, ingredient) => {
  if (ingredient.key === 'eggs') return total + ingredient.nutritionQuantity;
  if (ingredient.metricUnit === 'ml') return total + ingredient.metricQuantity;
  if (ingredient.metricUnit === 'g') return total + ingredient.metricQuantity;
  return total;
}, 0);
---

<SiteLayout title={recipe.pageTitle} description={recipe.description}>
  <div class="site-stack">
    <p class="recipe-source">Source: <a href={recipe.meta.sourceUrl}>{recipe.meta.sourceName}</a></p>
    <TerminalPanel title="Calculator" class="stack" id="calculator">
      <div class="calculator-grid" aria-live="polite">
        <div class="control-card batch-card">
          <label class="field" for="batch-input">
            <span>Batches</span>
            <input
              id="batch-input"
              type="number"
              min="0"
              step="any"
              inputmode="decimal"
              value="1"
              aria-describedby="batch-help"
            />
          </label>
          <small id="batch-help" class="muted">Enter any unsigned decimal batch count.</small>
        </div>

        <div class="control-card toggle-list" aria-label="Ingredient alternatives">
          {
            recipe.alternativeControls.map((control) => (
              <label>
                <input
                  id={`toggle-${control.key}`}
                  data-alternative-key={control.key}
                  type="checkbox"
                  checked={control.defaultChecked}
                />
                <span>{control.label}</span>
              </label>
            ))
          }
        </div>
        <div class="stat-card stat-cookies">
          <span>{servingPluralTitle}</span>
          <output id="servings-output">—</output>
          <small>{recipe.servingsPerBatch} {recipe.servingPlural} per batch.</small>
        </div>
        <div class="stat-card stat-dough">
          <span>{recipe.massLabel}</span>
          <output id="mass-output">{estimatedMassGrams.toFixed(0)}g</output>
          <small>{recipe.massDescription}</small>
        </div>
        <div class="stat-card stat-calories-batch">
          <span>Calories / batch</span>
          <output id="calories-batch-output">—</output>
          <small>{recipe.unavailableNutritionNote}</small>
        </div>
        <div class="stat-card stat-calories-serving">
          <span>Calories / {recipe.servingSingular}</span>
          <output id="calories-serving-output">—</output>
          <small>Calories per batch ÷ {recipe.servingsPerBatch} {recipe.servingPlural}.</small>
        </div>
        <div class="stat-card stat-macros-batch">
          <span>Macros / batch</span>
          <output id="macros-batch-output">—</output>
          <small>Protein / carbs / fat. {recipe.unavailableNutritionNote}</small>
        </div>
        <div class="stat-card stat-macros-serving">
          <span>Macros / {recipe.servingSingular}</span>
          <output id="macros-serving-output">—</output>
          <small>Per {recipe.servingSingular}, using {recipe.servingsPerBatch} {recipe.servingPlural} per batch.</small>
        </div>
        <div class="stat-card stat-used-cost">
          <span>Used ingredient cost</span>
          <output id="used-cost-output">—</output>
          <small>Proportional cost for the selected batch count.</small>
        </div>
        <div class="stat-card stat-basket">
          <span>Basket estimate</span>
          <output id="basket-cost-output">—</output>
          <small>Rounds up to whole Woolworths packs.</small>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-label="Scaled ingredient costs" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>Ingredient</th>
              <th>Source amount</th>
              <th>Scaled amount</th>
              <th>Woolworths item</th>
              <th>Used cost</th>
              <th>Packs / basket cost</th>
            </tr>
          </thead>
          <tbody id="ingredient-rows"></tbody>
        </table>
      </div>
    </TerminalPanel>

    <TerminalPanel title="Ingredients" id="recipe">
      <ul>
        {recipe.sourceIngredients.map((ingredient) => <li>{ingredient}</li>)}
      </ul>
    </TerminalPanel>

    <TerminalPanel title="Instructions">
      <ol>
        {recipe.sourceInstructions.map((step) => <li>{step}</li>)}
      </ol>
    </TerminalPanel>
  </div>

  <script is:inline type="application/json" id="calculator-data" set:html={JSON.stringify(calculatorData)} />

  <script src="../scripts/recipeCalculator.ts"></script>
</SiteLayout>
