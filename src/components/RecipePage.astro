---
import SiteLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import StatCard from '@brainage04/astro-shell/components/StatCard.astro';
import TerminalPanel from '@brainage04/astro-shell/components/TerminalPanel.astro';
import type { RecipePageData } from '../data/recipes';
import { batchMassGrams } from '../lib/calculations';
import PriceNote from './PriceNote.astro';

export interface Props {
  recipe: RecipePageData;
}

const { recipe } = Astro.props;
const calculatorData = {
  ingredients: recipe.ingredients,
  alternativeControls: recipe.alternativeControls,
  servingsPerBatch: recipe.servingsPerBatch,
  servingSingular: recipe.servingSingular,
  servingPlural: recipe.servingPlural,
};

const servingPluralTitle = `${recipe.servingPlural.charAt(0).toUpperCase()}${recipe.servingPlural.slice(1)}`;

const estimatedMassGrams = batchMassGrams(recipe.ingredients);
---

<SiteLayout title={recipe.pageTitle} description={recipe.description}>
  <div class="site-stack">
    <p class="recipe-source">Source: <a href={recipe.meta.sourceUrl}>{recipe.meta.sourceName}</a></p>
    <TerminalPanel title="Calculator" class="stack" id="calculator">
      <p id="calculator-summary" class="sr-only" role="status"></p>
      <div class="calculator-grid">
        <div class="control-card batch-card">
          <label class="field" for="batch-input">
            <span>Batches</span>
            <input
              id="batch-input"
              type="number"
              min="0"
              step="any"
              inputmode="decimal"
              value="1"
              aria-describedby="batch-help"
            />
          </label>
          <small id="batch-help" class="muted">Enter any unsigned decimal batch count.</small>
        </div>

        <div class="control-card toggle-list" role="group" aria-label="Ingredient alternatives">
          {
            recipe.alternativeControls.map((control) => (
              <label>
                <input
                  id={`toggle-${control.key}`}
                  data-alternative-key={control.key}
                  type="checkbox"
                  checked={control.defaultChecked}
                />
                <span>{control.label}</span>
              </label>
            ))
          }
        </div>
        <StatCard
          class="stat-cookies"
          label={servingPluralTitle}
          valueId="servings-output"
          note={`${recipe.servingsPerBatch} ${recipe.servingPlural} per batch.`}
        />
        <StatCard
          class="stat-dough"
          label={recipe.massLabel}
          valueId="mass-output"
          value={`${estimatedMassGrams.toFixed(0)}g`}
          note={recipe.massDescription}
        />
        <StatCard
          class="stat-calories-batch"
          label="Calories / batch"
          valueId="calories-batch-output"
          note={recipe.unavailableNutritionNote}
        />
        <StatCard
          class="stat-calories-serving"
          label={`Calories / ${recipe.servingSingular}`}
          valueId="calories-serving-output"
          note={`Calories per batch ÷ ${recipe.servingsPerBatch} ${recipe.servingPlural}.`}
        />
        <StatCard
          class="stat-macros-batch"
          label="Macros / batch"
          valueId="macros-batch-output"
          note={`Protein / carbs / fat. ${recipe.unavailableNutritionNote}`}
        />
        <StatCard
          class="stat-macros-serving"
          label={`Macros / ${recipe.servingSingular}`}
          valueId="macros-serving-output"
          note={`Per ${recipe.servingSingular}, using ${recipe.servingsPerBatch} ${recipe.servingPlural} per batch.`}
        />
        <StatCard
          class="stat-used-cost"
          label="Used ingredient cost"
          valueId="used-cost-output"
          note="Proportional cost for the selected batch count."
        />
        <StatCard
          class="stat-basket"
          label="Basket estimate"
          valueId="basket-cost-output"
          note="Rounds up to whole Woolworths packs."
        />
      </div>

      <PriceNote priceDates={[recipe.meta.priceDate]} />

      <div class="table-wrap table-wrap--stack" role="region" aria-label="Scaled ingredient costs" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>Ingredient</th>
              <th>Source amount</th>
              <th>Scaled amount</th>
              <th>Woolworths item</th>
              <th>Used cost</th>
              <th>Packs / basket cost</th>
            </tr>
          </thead>
          <tbody id="ingredient-rows"></tbody>
        </table>
      </div>
    </TerminalPanel>

    <TerminalPanel title="Ingredients" id="recipe">
      <ul>
        {recipe.sourceIngredients.map((ingredient) => <li>{ingredient}</li>)}
      </ul>
    </TerminalPanel>

    <TerminalPanel title="Instructions">
      <ol>
        {recipe.sourceInstructions.map((step) => <li>{step}</li>)}
      </ol>
    </TerminalPanel>
  </div>

  <script is:inline type="application/json" id="calculator-data" set:html={JSON.stringify(calculatorData)} />

  <script src="../scripts/recipeCalculator.ts"></script>
</SiteLayout>
